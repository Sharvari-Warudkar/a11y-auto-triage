{
  "name": "a11y-auto-triage",
  "version": "1.0.0",
  "description": "WCAG 2.1 Violation Auto-Triage & Bug Logger - AI-augmented accessibility QA pipeline",
  "main": "dist/pipeline.js",
  "scripts": {
    "build": "tsc",
    "scan": "ts-node src/scan.ts",
    "ingest": "ts-node src/rag/ingest.ts",
    "pipeline": "ts-node src/pipeline.ts",
    "pipeline:fresh": "ts-node src/pipeline.ts -- --skip-dedup",
    "scan:all": "ts-node src/scan-all.ts",
    "test": "playwright test"
  },
  "keywords": ["accessibility", "wcag", "a11y", "automation", "playwright", "qa", "typescript"],
  "author": "Sharvari Warudkar",
  "license": "ISC",
  "dependencies": {
    "@axe-core/playwright": "^4.9.0",
    "playwright": "^1.44.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0",
    "@playwright/test": "^1.44.0"
  }
}
